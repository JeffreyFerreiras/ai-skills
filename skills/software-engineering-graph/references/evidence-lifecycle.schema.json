{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex:engineering-graph:evidence-lifecycle:v1",
  "$comment": "Payload subtypes reuse existing artifact kinds. Activation, reservation, review binding and projections use evidence_manifest; repair_packet uses failure; acceptance_binding and planning_constraints use acceptance_evidence. Input manifests do not add artifact policy kinds. Authority, provenance and cross-record relations are validated by the engine.",
  "type": "object",
  "required": ["schema_version", "kind"],
  "properties": {"schema_version": {"const": 1}},
  "oneOf": [
    {
      "properties": {"kind": {"const": "check_coverage"}, "checks": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
        "type": "object", "additionalProperties": false, "required": ["check_id", "relevant_inputs", "complete"],
        "properties": {"check_id": {"type": "string"}, "complete": {"const": true}, "relevant_inputs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "maxLength": 1024}}}
      }}},
      "required": ["checks"], "propertyNames": {"enum": ["schema_version", "kind", "checks"]}
    },
    {
      "properties": {"kind": {"const": "generated_output_plan"}, "outputs": {"type": "array", "maxItems": 32, "items": {"$ref": "check-receipt.schema.json#/$defs/output"}}},
      "required": ["outputs"], "propertyNames": {"enum": ["schema_version", "kind", "outputs"]}
    },
    {
      "properties": {"kind": {"const": "repair_judgment"}, "cause": {"$ref": "#/$defs/cause"}, "failed_criterion_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "authorized_scope": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["effect", "action", "target_ref"], "properties": {"effect": {"type": "string"}, "action": {"type": "string"}, "target_ref": {"type": "string"}}}}},
      "required": ["cause", "failed_criterion_ids", "authorized_scope"], "propertyNames": {"enum": ["schema_version", "kind", "cause", "failed_criterion_ids", "authorized_scope"]}
    },
    {
      "properties": {"kind": {"const": "evidence_activation"}, "original_format": {"const": 6}, "complete": {"const": true}},
      "required": ["original_format", "run_id", "task_digest", "plan_digest", "policy_digest", "actor", "host_identity", "checks", "coverage_manifest_digest", "complete", "roots"],
      "propertyNames": {"enum": ["schema_version", "kind", "original_format", "run_id", "task_digest", "plan_digest", "policy_digest", "actor", "host_identity", "checks", "coverage_manifest_digest", "complete", "roots"]}
    },
    {
      "properties": {"kind": {"const": "check_reservation"}, "command": {"const": "check.start"}, "repeat_cost": {"enum": [0, 1]}, "budget_id": {"enum": ["delivery_repairs", "design_revisions"]}},
      "required": ["command", "check_id", "executor", "source", "source_generation", "predecessor_ref", "coverage", "activation_ref", "reservation_id", "before_source_digest", "repeat_cost", "budget_id", "request_digest", "review_source_binding_ref"],
      "propertyNames": {"enum": ["schema_version", "kind", "command", "check_id", "executor", "source", "source_generation", "predecessor_ref", "coverage", "activation_ref", "reservation_id", "before_source_digest", "repeat_cost", "budget_id", "request_digest", "review_source_binding_ref"]}
    },
    {
      "properties": {"kind": {"const": "review_source_binding"}},
      "required": ["run_id", "dependency_join_id", "source_generation", "source", "handoff_ref", "task_digest", "policy_digest", "plan_digest", "coverage", "coverage_digest", "source_digest", "outputs_digest"],
      "propertyNames": {"enum": ["schema_version", "kind", "run_id", "dependency_join_id", "source_generation", "source", "handoff_ref", "task_digest", "policy_digest", "plan_digest", "coverage", "coverage_digest", "source_digest", "outputs_digest"]}
    },
    {
      "properties": {"kind": {"const": "acceptance_binding"}},
      "required": ["criterion_id", "run_id", "task_digest", "plan_digest", "source", "source_digest", "coverage_digest", "review_source_binding_ref", "collection_ref", "consolidation_digest", "checks", "underlying_evidence", "actor", "predecessor_ref"],
      "propertyNames": {"enum": ["schema_version", "kind", "criterion_id", "run_id", "task_digest", "plan_digest", "source", "source_digest", "coverage_digest", "review_source_binding_ref", "collection_ref", "consolidation_digest", "checks", "underlying_evidence", "actor", "predecessor_ref"]}
    },
    {
      "properties": {
        "kind": {"const": "repair_packet"}, "cause": {"$ref": "#/$defs/cause"},
        "origin_kind": {"const": "delivery_review"},
        "origin_collection_id": {"type": "string", "minLength": 1},
        "origin_consolidation_ref": {"$ref": "#/$defs/artifactInput"},
        "origin_reports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/originReport"}}
      },
      "required": ["run_id", "task_digest", "plan_digest", "branch_id", "attempt_id", "generation", "state_revision", "origin_gate", "failure_evidence", "failure_result_ref", "failed_criterion_ids", "cause", "source_changes", "authorized_scope", "relevant_inputs", "return_gates", "remaining_retries", "remaining_allowances", "next_permitted_action", "unresolved_judgments"],
      "propertyNames": {"enum": ["schema_version", "kind", "run_id", "task_digest", "plan_digest", "branch_id", "attempt_id", "generation", "state_revision", "origin_gate", "failure_evidence", "failure_result_ref", "failed_criterion_ids", "cause", "source_changes", "authorized_scope", "relevant_inputs", "return_gates", "remaining_retries", "remaining_allowances", "next_permitted_action", "unresolved_judgments", "origin_kind", "origin_collection_id", "origin_consolidation_ref", "origin_reports"]},
      "oneOf": [
        {"not": {"anyOf": [{"required": ["origin_kind"]}, {"required": ["origin_collection_id"]}, {"required": ["origin_consolidation_ref"]}, {"required": ["origin_reports"]}]}},
        {"required": ["origin_kind", "origin_collection_id", "origin_consolidation_ref", "origin_reports"]}
      ]
    },
    {
      "properties": {"kind": {"const": "planning_constraints"}, "records": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/constraint"}}},
      "required": ["records"], "propertyNames": {"enum": ["schema_version", "kind", "records"]}
    },
    {
      "properties": {"kind": {"const": "planning_constraint_projection"}, "records": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/constraint"}}},
      "required": ["task_digest", "bundle_ref", "role", "scope_paths", "records", "diagnostics"],
      "propertyNames": {"enum": ["schema_version", "kind", "task_digest", "bundle_ref", "role", "scope_paths", "records", "diagnostics"]}
    }
  ],
  "$defs": {
    "cause": {"enum": ["implementation", "design", "dependency", "infrastructure", "unknown"]},
    "artifactReference": {
      "type": "object", "additionalProperties": false, "required": ["kind", "ref", "sha256"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "ref": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "artifactInput": {
      "type": "object", "additionalProperties": false, "required": ["kind", "ref", "sha256", "size_bytes"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "ref": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 0}}
    },
    "originReport": {
      "type": "object", "additionalProperties": false,
      "required": ["branch_id", "attempt_id", "result_ref", "artifact_ref", "findings", "evidence"],
      "properties": {
        "branch_id": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1},
        "result_ref": {"$ref": "#/$defs/artifactInput"},
        "artifact_ref": {"anyOf": [{"$ref": "#/$defs/artifactReference"}, {"type": "null"}]},
        "findings": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["finding_id", "disposition"],
          "properties": {"finding_id": {"type": "string", "minLength": 1}, "disposition": {"enum": ["approve", "revise", "accept", "repair", "redesign", "block"]}}
        }},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/artifactReference"}}
      }
    },
    "constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "statement", "rationale", "state", "repository_id", "paths", "roles", "acceptance_ids", "finding_id", "confirmed_finding_ref", "accepted_fix_ref", "authority_ref", "invalidation_reason", "supersedes"],
      "properties": {
        "id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "statement": {"type": "string", "maxLength": 4096}, "rationale": {"type": "string", "maxLength": 4096},
        "state": {"enum": ["candidate", "active", "invalidated", "superseded"]}, "repository_id": {"type": "string"},
        "paths": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "maxLength": 1024}},
        "roles": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}},
        "acceptance_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}},
        "finding_id": {"type": "string"}, "confirmed_finding_ref": {"type": ["string", "null"]}, "accepted_fix_ref": {"type": ["string", "null"]},
        "authority_ref": {"type": "string"}, "invalidation_reason": {"type": ["string", "null"], "maxLength": 1024},
        "supersedes": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 160}}
      }
    }
  }
}
