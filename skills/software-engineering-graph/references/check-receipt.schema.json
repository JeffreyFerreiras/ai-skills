{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex:engineering-graph:check-receipt:v2",
  "oneOf": [
    {"properties": {"schema_version": {"const": 1}}, "propertyNames": {"enum": ["schema_version", "kind", "run_id", "check_id", "command_id", "argv", "outcome", "exit_code", "timed_out", "stdout_sha256", "stderr_sha256", "repo_worktree_sha256", "started_at", "finished_at", "producer_actor", "producer_host_identity"]}},
    {"properties": {"schema_version": {"const": 2}}, "required": ["executor", "source", "source_generation", "task_digest", "plan_digest", "policy_digest", "reservation_id", "predecessor_ref", "coverage", "coverage_digest", "before_source_digest", "after_source_digest", "validity", "activation_ref", "review_source_binding_ref"]}
  ],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "run_id", "check_id", "command_id", "argv", "outcome", "exit_code", "timed_out", "stdout_sha256", "stderr_sha256", "repo_worktree_sha256", "started_at", "finished_at", "producer_actor", "producer_host_identity"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "executor": {"$ref": "#/$defs/fence"},
    "source": {"$ref": "#/$defs/fence"},
    "source_generation": {"type": "integer", "minimum": 0},
    "task_digest": {"$ref": "#/$defs/digest"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "reservation_id": {"$ref": "#/$defs/id"},
    "predecessor_ref": {"type": ["string", "null"]},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["roots", "outputs", "activation_ref"], "properties": {
      "roots": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "maxLength": 1024}},
      "outputs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/output"}},
      "activation_ref": {"type": "string"}
    }},
    "coverage_digest": {"$ref": "#/$defs/digest"},
    "before_source_digest": {"$ref": "#/$defs/digest"},
    "after_source_digest": {"$ref": "#/$defs/digest"},
    "validity": {"enum": ["valid", "source_changed", "unverifiable"]},
    "activation_ref": {"type": "string"},
    "review_source_binding_ref": {"type": ["string", "null"]},
    "kind": {"const": "check_receipt"},
    "run_id": {"$ref": "#/$defs/id"},
    "check_id": {"$ref": "#/$defs/id"},
    "command_id": {"$ref": "#/$defs/id"},
    "argv": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "outcome": {"enum": ["PASS", "FAIL"]},
    "exit_code": {"type": "integer"},
    "timed_out": {"type": "boolean"},
    "stdout_sha256": {"$ref": "#/$defs/digest"},
    "stderr_sha256": {"$ref": "#/$defs/digest"},
    "repo_worktree_sha256": {"$ref": "#/$defs/digest"},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "producer_actor": {"type": "string", "minLength": 1},
    "producer_host_identity": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "fence": {"type": "object", "additionalProperties": false, "required": ["branch_id", "attempt_id", "claim_digest", "result_digest"], "properties": {
      "branch_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"},
      "claim_digest": {"$ref": "#/$defs/digest"}, "result_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
    }},
    "output": {"type": "object", "additionalProperties": false, "required": ["path", "purpose", "producer_node_key", "artifact_kind"], "properties": {
      "path": {"type": "string", "maxLength": 1024}, "purpose": {"enum": ["review_report", "consolidation", "acceptance_wrapper"]},
      "producer_node_key": {"$ref": "#/$defs/id"}, "artifact_kind": {"type": "string"}
    }},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
