{
  "description": "Local Laya task advice. Keeps the current Codex model and fails open.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import runpy,subprocess,sys;from pathlib import Path;p=Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip())/'scripts';sys.path.insert(0,str(p));runpy.run_path(str(p/'laya-hook.py'),run_name='__main__')\"",
            "commandWindows": "python -c \"import runpy,subprocess,sys;from pathlib import Path;p=Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip())/'scripts';sys.path.insert(0,str(p));runpy.run_path(str(p/'laya-hook.py'),run_name='__main__')\"",
            "timeout": 5,
            "statusMessage": "Checking local Laya task advice"
          }
        ]
      }
    ]
  }
}
